rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // دالة التحقق من هوية المسؤول الأكاديمي والإداري (Admin)
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email != null && 
             (request.auth.token.email.lower() == "ammaramrcan@gmail.com" ||
              (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"));
    }

    // دالة التحقق من تسجيل الدخول
    function isSignedIn() {
      return request.auth != null;
    }

    // دالة التحقق من ملكية المستند لمالكه الأصلي
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 1. الحذوفات العامة وحظر المحتوى (محصورة بالأدمن فقط للتعديل، ومتاحة للقراءة للجميع)
    match /global_deleted_items/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. بيانات وتقييمات المعلمين (محصورة بالأدمن للتعديل)
    match /teachers/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. بيانات مستندات المستخدمين الشخصية (محصورة للمالك أو الأدمن)
    match /users/{userId}/{document=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /google_registered_users/{document=**} {
      allow read: if isOwner(document) || isAdmin();
      allow write: if isOwner(document) || isAdmin();
    }

    match /global_registered_users/{document=**} {
      allow read: if isOwner(document) || isAdmin();
      allow write: if isOwner(document) || isAdmin();
    }

    // 4. المحتوى المخصص (الرفع للمسجلين بشرط حالة المعاينة pending ما لم يكن أدمن)
    match /custom_content/{document=**} {
      allow read: if true;
      allow create: if isSignedIn() && (request.resource.data.status == "pending" || isAdmin());
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // 5. التحليلات العامة (تحديث العدادات للمسجلين والضيوف، ولا يمكن الحذف إلا للأدمن)
    match /analytics_summary/{document=**} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // 6. قواعد افتراضية آمنة لباقي المستندات
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
