rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. العناصر المحذوفة عامة وللمستخدمين
    match /global_deleted_items/{document=**} {
      allow read, write: if true;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if true;
    }

    // 2. المحتوى المخصص والمستخدمين المسجلين بـ Google
    match /custom_content/{document=**} {
      allow read, write: if true;
    }

    match /google_registered_users/{document=**} {
      allow read, write: if true;
    }

    // 3. قواعد افتراضية مسموحة بقراءة باقي المستندات
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
